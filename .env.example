# Sentinel-DNS local configuration. Copy to a gitignored `.env` and fill secrets.
# Never commit real tokens, passwords, private keys, or model files.

# Process
SENTINEL_APP_HOST=127.0.0.1
SENTINEL_APP_PORT=8000
SENTINEL_DETECTOR_VERSION=1.0.0
SENTINEL_RUNTIME_PROFILE=hackathon
SENTINEL_NO_EGRESS=true
SENTINEL_REQUIRE_SYNTHETIC=true
SENTINEL_CLOCK_SKEW_TOLERANCE_SECONDS=300
SENTINEL_INTERNAL_QUEUE_MAX_EVENTS=5000

# Heuristic / QVAC candidate band (not threat-family thresholds)
SENTINEL_HEURISTIC_ALERT_THRESHOLD=0.90
SENTINEL_HEURISTIC_QVAC_MIN_SCORE=0.45
SENTINEL_QVAC_ENABLED=true
QVAC_CACHE_DIR=./data/qvac
# Worker: `npm install` in the repo root (node_modules/@qvac/sdk).
# QVAC_SDK_DIR=./node_modules/@qvac/sdk
# QVAC_WORKER_PATH=
# QVAC_BARE_PATH=
# Spec MVP: 1.5s. Qwen3-0.6B on CPU often needs more; override locally.
SENTINEL_QVAC_TIMEOUT_SECONDS=8
SENTINEL_QVAC_CONCURRENCY=1

# Webhook authentication: prefer a mounted secret file
# SENTINEL_WEBHOOK_TOKEN_FILE=/run/secrets/sentinel_webhook_token
# SENTINEL_WEBHOOK_TOKEN=

# Kafka contracts (topic names are frozen)
# Inside Docker Compose, services reach the broker by its service name.
SENTINEL_KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# From the host (simulator, tests or debugging outside Compose), use the
# loopback listener that compose.yaml publishes on 127.0.0.1:29092 instead:
# SENTINEL_KAFKA__BOOTSTRAP_SERVERS=localhost:29092
#
# Access: the local broker runs PLAINTEXT without authentication. It is only
# reachable on the internal `sentinel-net` network and on loopback, never on a
# public interface. KafkaSettings has no credential fields yet, so SASL or
# password variables set here would be silently ignored; adding broker auth
# requires extending app/core/config.py and compose.yaml together.
SENTINEL_KAFKA__TOPIC_NORMALIZED=dns.telemetry.normalized
SENTINEL_KAFKA__TOPIC_DLQ=sentinel.dns.dlq
SENTINEL_KAFKA__TOPIC_GROUNDTRUTH=sentinel.dns.groundtruth
SENTINEL_KAFKA__CONSUMER_GROUP=sentinel-dns
SENTINEL_KAFKA__POLL_MAX_RECORDS=500

# Wazuh local API
SENTINEL_WAZUH__BASE_URL=https://wazuh-manager:55000
SENTINEL_WAZUH__EVENTS_PATH=/events
SENTINEL_WAZUH__AUTHENTICATE_PATH=/security/user/authenticate
SENTINEL_WAZUH__VERIFY_TLS=true
# SENTINEL_WAZUH__CA_PATH=/run/secrets/wazuh_ca.pem
# SENTINEL_WAZUH__USERNAME_FILE=/run/secrets/wazuh_username
# SENTINEL_WAZUH__PASSWORD_FILE=/run/secrets/wazuh_password
SENTINEL_WAZUH__BATCH_MAX=100
SENTINEL_WAZUH__FLUSH_SECONDS=2
SENTINEL_WAZUH__MAX_REQUESTS_PER_MINUTE=30

# ClickHouse QoE
SENTINEL_CLICKHOUSE__HOST=clickhouse
# From the host (`make api`), Compose publishes HTTP on 127.0.0.1:8123:
# SENTINEL_CLICKHOUSE__HOST=localhost
SENTINEL_CLICKHOUSE__HTTP_PORT=8123
SENTINEL_CLICKHOUSE__DATABASE=sentinel_dns
SENTINEL_CLICKHOUSE__QOE_TABLE=dns_qoe_1m
# SENTINEL_CLICKHOUSE__USERNAME_FILE=/run/secrets/clickhouse_username
# SENTINEL_CLICKHOUSE__PASSWORD_FILE=/run/secrets/clickhouse_password
SENTINEL_CLICKHOUSE__SECURE=false

# Outbox
SENTINEL_OUTBOX__PATH=./data/outbox/sentinel.db
SENTINEL_OUTBOX__CLAIM_LIMIT=100
SENTINEL_OUTBOX__MAX_BYTES=268435456

# Background workers (1=on). Unit tests force these off.
# SENTINEL_ENABLE_KAFKA_CONSUMER=1
# SENTINEL_ENABLE_WAZUH_DISPATCHER=1
# SENTINEL_ENABLE_QOE_FLUSH=1

# LogoDNSQueries: optional raw dumps (gitignored). Curated fixtures live in tests/fixtures/dns/.
# Place CSV/JSON/JSONL here; do not commit the dataset.
# data/LogoDNSQueries/

# QoE window policy; numeric thresholds live in config/qoe_thresholds.yaml
SENTINEL_QOE_WINDOW_SECONDS=60
SENTINEL_QOE_MIN_SAMPLES=20
SENTINEL_QOE_CALCULATION_VERSION=1.0
SENTINEL_FEATURES_CONFIG_PATH=./config/features.yaml
SENTINEL_BRANDS_CONFIG_PATH=./config/brands.yaml
SENTINEL_QOE_THRESHOLDS_PATH=./config/qoe_thresholds.yaml
